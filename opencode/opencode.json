{
  "$schema": "https://opencode.ai/config.json",
  "permission": "allow",
  "plugin": [
    "@mohak34/opencode-notifier@0.2.5",
    "@grafana/agento11y-opencode"
  ],
  "model": "anthropic/claude-opus-5",
  "theme": "kanagawa",
  "provider": {
    "switchyard": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Switchyard",
      "options": {
        "baseURL": "http://127.0.0.1:4000/v1",
        "apiKey": "switchyard-local"
      },
      "models": {
        "impl-smart": {
          "name": "Implementer (stage-routed sonnet/haiku)"
        },
        "explore-cheap": {
          "name": "Explore (haiku passthrough)"
        }
      }
    }
  },
  "agent": {
    "plan": {
      "model": "anthropic/claude-opus-5"
    },
    "build": {
      "model": "anthropic/claude-opus-5"
    },
    "explore": {
      "model": "switchyard/explore-cheap"
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "qdrant-code": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@mhalder/qdrant-mcp-server@3.3.4"
      ],
      "enabled": true,
      "environment": {
        "QDRANT_URL": "http://localhost:6333",
        "EMBEDDING_PROVIDER": "openai",
        "OLLAMA_BASE_URL": "http://localhost:11434",
        "OPENAI_MODEL": "text-embedding-3-small"
      }
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--headless",
        "--chromeArg=--no-sandbox"
      ],
      "enabled": true
    },
    "slack": {
      "type": "remote",
      "url": "https://mcp.slack.com/mcp",
      "enabled": true,
      "oauth": {
        "clientId": "1601185624273.8899143856786",
        "callbackPort": 3118,
        "redirectUri": "http://localhost:3118/callback"
      }
    }
  }
}
